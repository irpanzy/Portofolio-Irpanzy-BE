{
  "name": "portofolio-irpanzy-be",
  "version": "1.0.0",
  "description": "Backend API for Irfan Muria Portfolio with AI Chatbot",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts,json --ignore src/**/*.test.ts --exec tsx src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "seed": "tsx src/seeds/seed.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "portfolio",
    "api",
    "typescript",
    "express",
    "ai-chatbot"
  ],
  "author": "Irfan Muria",
  "license": "ISC",
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^16.3.1",
    "express": "^5.2.1",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "helmet": "^8.3.0",
    "imagekit": "^5.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.0",
    "morgan": "^1.11.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^10.0.0",
    "xss-clean": "^0.1.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^26.1.1",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
